# Server Configuration
PORT=3000
HOST=localhost

# Scraper Configuration
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT=30000
HEADLESS=true

# Number of Google Maps detail pages processed in parallel (default: 3)
DETAIL_CONCURRENCY=3

# Number of business websites scraped for contacts in parallel (default: 4)
WEBSITE_CONCURRENCY=4

# Block images/fonts/media for faster page loads (default: true)
BLOCK_RESOURCES=true

# Extra URLs collected beyond the requested quantity to compensate
# extraction failures and filtered-out results (default: 1.4 = +40%)
URL_OVERFETCH_RATIO=1.4
